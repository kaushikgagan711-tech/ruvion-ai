# Required for live Gemini streaming
GEMINI_API_KEY=
RUVION_PAYMENT_MODE=test
# Required only to enable Plus / Pro checkout. Keep all three server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set this to the deployed HTTPS origin, e.g. https://api.ruvion.app
RUVION_PUBLIC_ORIGIN=https://api.ruvion.app
